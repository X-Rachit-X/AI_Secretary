{
  "name": "cortex-one",
  "private": true,
  "version": "1.0.0",
  "description": "One multi-agent assistant: chat, web search, code, PDF, PPT, images, vision, doc Q&A, Google Calendar, Gmail and notifications.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run db:push -w server",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "db:push": "npm run db:push -w server",
    "db:studio": "npm run db:studio -w server",
    "db:pg:sync": "npm run db:pg:sync -w server --",
    "db:pg:migrate": "npm run db:pg:migrate -w server --",
    "mcp": "npm run mcp -w server",
    "eval": "npm run eval -w server",
    "eval:live": "npm run eval:live -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
