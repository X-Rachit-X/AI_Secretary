{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp/stdio.ts",
    "db:push": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "db:pg:sync": "node scripts/postgres-schema.mjs",
    "db:pg:migrate": "npm run db:pg:sync && prisma migrate dev --schema prisma/postgres/schema.prisma --skip-generate",
    "eval": "tsx src/evals/run.ts",
    "eval:live": "tsx src/evals/run.ts --live --json"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.1.0",
    "@langchain/core": "^1.2.0",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/openai": "^1.2.0",
    "@langchain/tavily": "^1.2.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.3",
    "prisma": "^6.19.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  }
}
