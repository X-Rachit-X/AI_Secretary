# ─────────────────────────────────────────────────────────────────────────────
# CortexOne — copy this file to .env and fill in the values.
# Only the keys marked REQUIRED are needed to boot the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# REQUIRED. Any long random string. Signs the session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database (SQLite — no install needed) ────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which provider the agents use: google | openai | groq | anthropic
LLM_PROVIDER=google

# REQUIRED when LLM_PROVIDER=google. Also used for embeddings (doc Q&A)
# regardless of provider.  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Optional alternative providers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# ── Google OAuth (Calendar + Gmail + sign-in) ────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add the redirect URI below to "Authorized redirect URIs".
# Enable the "Google Calendar API" and "Gmail API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Web search (optional — the search agent degrades gracefully without it) ──
# https://tavily.com
TAVILY_API_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
# Cron expression for the reminder sweep. Default: every 5 minutes.
REMINDER_CRON=*/5 * * * *
# Create a reminder this many minutes before a meeting starts.
REMINDER_LEAD_MINUTES=15

# ── LLM gateway (retries, timeouts, fallback) ────────────────────────────────
# Secondary provider tried when the primary keeps failing. Leave empty to
# disable. Must differ from LLM_PROVIDER to have any effect.
LLM_FALLBACK_PROVIDER=
# Hard ceiling on a single model call, so a hung provider cannot stall a request.
LLM_TIMEOUT_MS=60000
# Retries on transient failures (429, 5xx) before the fallback is tried.
LLM_MAX_RETRIES=2

# ── OpenRouter: a hosted LLM gateway, one key in front of many providers ─────
# Set LLM_PROVIDER=openrouter to use it. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
